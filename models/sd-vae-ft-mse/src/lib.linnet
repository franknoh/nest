// The decoder half of Stability AI's MSE-finetuned Stable Diffusion
// autoencoder: a 1x1 convolution off the 4-channel latent, a mid block with
// spatial self-attention, and four up-sampling stages back to an RGB image.
// This is Nest's first diffusion-family model, and the first to use group
// normalization, nearest upsampling, and attention over spatial positions
// rather than a token sequence.
//
// Only `decode` is implemented; the encoder (the other half of the
// checkpoint, `encoder.*` and `quant_conv.*`) is future work.
module sd_vae

use std.nn.activations::{silu}
use std.nn.attention::{attention}
use std.nn.conv::{Conv2d}
use std.nn.linear::{Linear}
use std.nn.norm::{group_norm}
use std.nn.resize::{upsample_nearest2d}

// Group normalization always runs at 32 groups and eps 1e-6 in this
// checkpoint, both for the residual blocks and for the attention block, so
// the count is not a generic here.
pub const EPS: f32 = 1e-6

pub block GroupNorm<C: Dim, T: Float>
where C % 32 == 0 {
    param weight: Tensor[C; T]
    param bias: Tensor[C; T]

    pub fn forward<B: Dim, H: Dim, W: Dim>(x: Tensor[B, C, H, W; T]) -> Tensor[B, C, H, W; T] {
        return group_norm<B, C, H, W, 32, T>(x, weight, bias, EPS)
    }
}

// group_norm -> SiLU -> conv3x3 -> group_norm -> SiLU -> conv3x3, added to
// the input. This variant keeps the width constant, so the shortcut is the
// input itself.
pub block ResBlock<C: Dim, T: Float>
where C % 32 == 0 {
    sub norm1: GroupNorm<C, T>
    sub conv1: Conv2d<C, C, 3, 1, 1, T>
    sub norm2: GroupNorm<C, T>
    sub conv2: Conv2d<C, C, 3, 1, 1, T>

    pub fn forward<B: Dim, H: Dim, W: Dim>(x: Tensor[B, C, H, W; T]) -> Tensor[B, C, H, W; T] {
        let h = conv1.forward(silu(norm1.forward(x)))
        let out = conv2.forward(silu(norm2.forward(h)))
        return out + x
    }
}

// The same residual block, widened: the first group norm and convolution
// read `Cin` channels, the rest read `Cout`, and the shortcut is a 1x1
// convolution that projects the input to match.
pub block ResBlockWiden<Cin: Dim, Cout: Dim, T: Float>
where
    Cin % 32 == 0,
    Cout % 32 == 0
{
    sub norm1: GroupNorm<Cin, T>
    sub conv1: Conv2d<Cin, Cout, 3, 1, 1, T>
    sub norm2: GroupNorm<Cout, T>
    sub conv2: Conv2d<Cout, Cout, 3, 1, 1, T>
    sub shortcut: Conv2d<Cin, Cout, 1, 1, 0, T>

    pub fn forward<B: Dim, H: Dim, W: Dim>(x: Tensor[B, Cin, H, W; T]) -> Tensor[B, Cout, H, W; T] {
        let h = conv1.forward(silu(norm1.forward(x)))
        let out = conv2.forward(silu(norm2.forward(h)))
        return out + shortcut.forward(x)
    }
}

// Self-attention over the `H * W` spatial positions of the mid block, with a
// single head spanning the whole channel width. A group norm precedes it;
// the checkpoint stores the query/key/value/output projections as plain
// linear layers (`query`, `key`, `value`, `proj_attn` in the raw tensor
// names), which is what `Linear` below binds to.
pub block SpatialAttention<C: Dim, T: Float>
where C % 32 == 0 {
    sub norm: GroupNorm<C, T>
    sub query: Linear<C, C, T>
    sub key: Linear<C, C, T>
    sub value: Linear<C, C, T>
    sub proj: Linear<C, C, T>

    pub fn forward<B: Dim, H: Dim, W: Dim>(x: Tensor[B, C, H, W; T]) -> Tensor[B, C, H, W; T] {
        let normed = norm.forward(x)
        // Flatten the grid to a sequence, channel last, for the projections
        // and the attention contraction; a single head spans all of `C`.
        let seq = permute(reshape(normed, [B, C, H * W]), [0, 2, 1])
        let q = reshape(query.forward(seq), [B, 1, H * W, C])
        let k = reshape(key.forward(seq), [B, 1, H * W, C])
        let v = reshape(value.forward(seq), [B, 1, H * W, C])
        let mixed = attention(q, k, v, rsqrt(cast<f32>(C)), none)
        let flat = reshape(mixed, [B, H * W, C])
        let projected = proj.forward(flat)
        let spatial = reshape(permute(projected, [0, 2, 1]), [B, C, H, W])
        return spatial + x
    }
}

// Residual block, attention, residual block, all at the decoder's widest
// resolution and channel count.
pub block MidBlock<C: Dim, T: Float>
where C % 32 == 0 {
    sub first: ResBlock<C, T>
    sub attention: SpatialAttention<C, T>
    sub second: ResBlock<C, T>

    pub fn forward<B: Dim, H: Dim, W: Dim>(x: Tensor[B, C, H, W; T]) -> Tensor[B, C, H, W; T] {
        return second.forward(attention.forward(first.forward(x)))
    }
}

// Three residual blocks at constant width, then a nearest-neighbour
// upsample and a 3x3 convolution that mixes the doubled grid.
pub block UpBlock<C: Dim, T: Float>
where C % 32 == 0 {
    sub first: ResBlock<C, T>
    sub second: ResBlock<C, T>
    sub third: ResBlock<C, T>
    sub upsample: Conv2d<C, C, 3, 1, 1, T>

    pub fn forward<B: Dim, H: Dim, W: Dim>(x: Tensor[B, C, H, W; T]) -> Tensor[B, C, H * 2, W *
        2; T] {
        let resnetted = third.forward(second.forward(first.forward(x)))
        return upsample.forward(upsample_nearest2d<B, C, H, W, 2, T>(resnetted))
    }
}

// The same, but the first residual block also narrows the width from `Cin`
// to `Cout`, as the two final up blocks do.
pub block UpBlockWiden<Cin: Dim, Cout: Dim, T: Float>
where
    Cin % 32 == 0,
    Cout % 32 == 0
{
    sub first: ResBlockWiden<Cin, Cout, T>
    sub second: ResBlock<Cout, T>
    sub third: ResBlock<Cout, T>
    sub upsample: Conv2d<Cout, Cout, 3, 1, 1, T>

    pub fn forward<B: Dim, H: Dim, W: Dim>(x: Tensor[B, Cin, H, W; T]) -> Tensor[B, Cout, H * 2, W *
        2; T] {
        let resnetted = third.forward(second.forward(first.forward(x)))
        return upsample.forward(upsample_nearest2d<B, Cout, H, W, 2, T>(resnetted))
    }
}

// The last up block narrows the width the same way but has no upsampler:
// its output is already at the full 8x resolution.
pub block UpBlockWidenFinal<Cin: Dim, Cout: Dim, T: Float>
where
    Cin % 32 == 0,
    Cout % 32 == 0
{
    sub first: ResBlockWiden<Cin, Cout, T>
    sub second: ResBlock<Cout, T>
    sub third: ResBlock<Cout, T>

    pub fn forward<B: Dim, H: Dim, W: Dim>(x: Tensor[B, Cin, H, W; T]) -> Tensor[B, Cout, H, W; T] {
        return third.forward(second.forward(first.forward(x)))
    }
}

pub block Model<H: Dim, W: Dim, T: Float = f32> {
    // A 1x1 convolution on the 4-channel latent (the checkpoint keeps it
    // separate from the decoder proper, ahead of `decoder.conv_in`).
    sub post_quant_conv: Conv2d<4, 4, 1, 1, 0, T>
    sub conv_in: Conv2d<4, 512, 3, 1, 1, T>
    sub mid_block: MidBlock<512, T>
    // Widths go 512, 512, 512, 256, 128: the first two up blocks hold at
    // 512, the third narrows to 256, the fourth to 128. Only the last of
    // the four skips the upsample, since its output is already full size.
    sub up_block_0: UpBlock<512, T>
    sub up_block_1: UpBlock<512, T>
    sub up_block_2: UpBlockWiden<512, 256, T>
    sub up_block_3: UpBlockWidenFinal<256, 128, T>
    sub norm_out: GroupNorm<128, T>
    sub conv_out: Conv2d<128, 3, 3, 1, 1, T>

    // The real pipeline scales its latent by `1 / 0.18215` before decoding
    // (and the encoder would have scaled by `0.18215` going the other way).
    // That scaling is not part of this entry: it belongs to the caller, the
    // same way `diffusers.AutoencoderKL.decode` never applies it itself and
    // only the pipeline around it does. Callers reproducing the Stable
    // Diffusion pipeline must scale before calling `decode`.
    pub entry decode<B: Dim>(latent: Tensor[B, 4, H, W; T]) -> Tensor[B, 3, H * 8, W * 8; T] {
        let embedded = conv_in.forward(post_quant_conv.forward(latent))
        let mid = mid_block.forward(embedded)
        let up0 = up_block_0.forward(mid)
        let up1 = up_block_1.forward(up0)
        let up2 = up_block_2.forward(up1)
        let up3 = up_block_3.forward(up2)
        return conv_out.forward(silu(norm_out.forward(up3)))
    }
}
