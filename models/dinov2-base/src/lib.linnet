// DINOv2: a self-supervised Vision Transformer whose output features are
// used directly, without fine-tuning, for retrieval, segmentation and depth.
// The encoder is the same pre-norm block ViT uses, plus two additions:
//
// - LayerScale multiplies each residual branch by a learned per-channel
//   vector before it is added back, which is what lets a plain ViT train
//   stably at this depth without fine-tuning supervision.
// - The position table is stored at the checkpoint's native resolution
//   (`image_size` / `patch_size` from `config.json`) and the reference
//   implementation bicubically interpolates it for other input sizes.
//   Bicubic interpolation has no Linnet expression today, so this source
//   only supports the native resolution, where the stored table is used as
//   it is (the reference's interpolation is a no-op exactly there too).
module dinov2

use std.nn.activations::{gelu_erf}
use std.nn.attention::{attention}
use std.nn.linear::{Linear}
use std.nn.norm::{layer_norm}

pub const EPS: f32 = 1e-6

pub block LayerNorm<D: Dim, T: Float> {
    param weight: Tensor[D; T]
    param bias: Tensor[D; T]

    pub fn forward<*S: Shape>(x: Tensor[*S, D; T]) -> Tensor[*S, D; T] {
        return layer_norm(x, weight, some(bias), EPS)
    }
}

// A learned per-channel gate on a residual branch: `x * lambda1`, applied
// to the attention and MLP outputs before they are added back to the
// stream. `lambda1` starts near zero at training time so early layers
// behave like an identity function; at inference it is just the checkpoint
// vector.
pub block LayerScale<D: Dim, T: Float> {
    param lambda1: Tensor[D; T]

    pub fn forward<*S: Shape>(x: Tensor[*S, D; T]) -> Tensor[*S, D; T] {
        return x * lambda1
    }
}

pub block Attention<D: Dim, Heads: Dim, T: Float>
where
    Heads > 0,
    D % Heads == 0
{
    sub query: Linear<D, D, T>
    sub key: Linear<D, D, T>
    sub value: Linear<D, D, T>
    sub out: Linear<D, D, T>

    // Full attention over every token: DINOv2 has no padding to mask,
    // since every input is one square image with no variable-length text.
    pub fn forward<B: Dim, N: Dim>(x: Tensor[B, N, D; T]) -> Tensor[B, N, D; T] {
        let mixed = attention(
            heads<B, N, Heads, D / Heads, T>(query.forward(x)),
            heads<B, N, Heads, D / Heads, T>(key.forward(x)),
            heads<B, N, Heads, D / Heads, T>(value.forward(x)),
            rsqrt(cast<f32>(D / Heads)),
            none,
        )
        return out.forward(reshape(permute(mixed, [0, 2, 1, 3]), [B, N, D]))
    }
}

fn heads<B: Dim, N: Dim, Heads: Dim, Dh: Dim, T: Float>(
    x: Tensor[B, N, Heads * Dh; T],
) -> Tensor[B, Heads, N, Dh; T] {
    return permute(reshape(x, [B, N, Heads, Dh]), [0, 2, 1, 3])
}

pub block EncoderLayer<D: Dim, Heads: Dim, Inner: Dim, T: Float>
where
    Heads > 0,
    D % Heads == 0
{
    sub norm1: LayerNorm<D, T>
    sub attention: Attention<D, Heads, T>
    sub layer_scale1: LayerScale<D, T>
    sub norm2: LayerNorm<D, T>
    sub up: Linear<D, Inner, T>
    sub down: Linear<Inner, D, T>
    sub layer_scale2: LayerScale<D, T>

    pub fn forward<B: Dim, N: Dim>(x: Tensor[B, N, D; T]) -> Tensor[B, N, D; T] {
        let attended = x + layer_scale1.forward(attention.forward(norm1.forward(x)))
        return attended +
            layer_scale2.forward(down.forward(gelu_erf(up.forward(norm2.forward(attended)))))
    }
}

pub block Model<
    Height: Dim,
    Width: Dim,
    Channels: Dim,
    Patch: Dim,
    D: Dim,
    Heads: Dim,
    Inner: Dim,
    Layers: Dim,
    T: Float = f32,
>
where
    Patch > 0,
    Heads > 0,
    Height % Patch == 0,
    Width % Patch == 0,
    D % Heads == 0
{
    // The shapes a `Conv2d` checkpoint stores, read as a contraction below.
    param patch_weight: Tensor[D, Channels, Patch, Patch; T]
    param patch_bias: Tensor[D; T]
    param class_token: Tensor[1, 1, D; T]
    // Stored at the checkpoint's native grid; see the module comment.
    param positions: Tensor[1, (Height / Patch) * (Width / Patch) + 1, D; T]
    sub layers: [EncoderLayer<D, Heads, Inner, T>; Layers]
    sub norm: LayerNorm<D, T>

    // The class token followed by the patch tokens, after the final layer
    // norm: the class token is the image embedding used for retrieval, and
    // the patch tokens are the dense per-patch features used for
    // segmentation and depth.
    pub entry forward<B: Dim>(
        image: Tensor[B, Channels, Height, Width; T],
    ) -> Tensor[B, (Height / Patch) * (Width / Patch) + 1, D; T] {
        let patches = embed<B>(image)
        // The class token leads, then the position table adds over the batch.
        let tokens = concat(broadcast_to(class_token, [B, 1, D]), patches, axis = 1) + positions
        var x = tokens
        static for layer in layers {
            x = layer.forward(x)
        }
        return norm.forward(x)
    }

    // `[B, C, Height, Width]` -> `[B, Patches, D]`: each patch contracted
    // with the convolution's window, in the order a convolution reads it.
    fn embed<B: Dim>(
        image: Tensor[B, Channels, Height, Width; T],
    ) -> Tensor[B, (Height / Patch) * (Width / Patch), D; T] {
        let grid = reshape(image, [B, Channels, Height / Patch, Patch, Width / Patch, Patch])
        let windows = reshape(
            permute(grid, [0, 2, 4, 1, 3, 5]),
            [B, (Height / Patch) * (Width / Patch), Channels, Patch, Patch],
        )
        let embedded[b, p, d] = sum[c, i, j] windows[b, p, c, i, j] * patch_weight[d, c, i, j]
        return embedded + patch_bias
    }
}
