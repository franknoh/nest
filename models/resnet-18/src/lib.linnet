// ResNet-18 for ImageNet-1k classification: a 7x7 stem, four stages of two
// residual blocks, and a linear classifier over the spatially averaged
// features. The first block of a stage that changes width also halves the
// resolution and projects its shortcut with a 1x1 convolution.
//
// Every convolution keeps the four-axis weight the checkpoint stores, and
// the batch statistics are read as they were measured: inference batch
// normalization is an affine transform along the channel axis.
module resnet

use std.nn.activations::{relu}
use std.nn.conv::{Conv2d}
use std.nn.linear::{Linear}
use std.nn.norm::{batch_norm}
use std.nn.pool::{global_average_pool2d, max_pool2d}

// A convolution followed by its normalization, the pair the checkpoint
// stores together.
pub block ConvNorm<Cin: Dim, Cout: Dim, K: Dim, Stride: Dim, Pad: Dim, T: Float>
where
    Stride > 0,
    K > 0
{
    sub convolution: Conv2d<Cin, Cout, K, Stride, Pad, T>
    param running_mean: Tensor[Cout; T]
    param running_var: Tensor[Cout; T]
    param weight: Tensor[Cout; T]
    param bias: Tensor[Cout; T]

    pub fn forward<B: Dim, H: Dim, W: Dim>(
        x: Tensor[B, Cin, H, W; T],
    ) -> Tensor[B, Cout, (H + 2 * Pad - K) / Stride + 1, (W + 2 * Pad - K) / Stride + 1; T] {
        return batch_norm(convolution.forward(x), running_mean, running_var, weight, bias)
    }
}

// Two 3x3 convolutions at constant width and resolution, added to the input.
pub block Block<C: Dim, T: Float> {
    sub first: ConvNorm<C, C, 3, 1, 1, T>
    sub second: ConvNorm<C, C, 3, 1, 1, T>

    pub fn forward<B: Dim, H: Dim, W: Dim>(
        x: Tensor[B, C, H, W; T],
    ) -> Tensor[B, C, H, W; T] {
        let inner = relu(first.forward(x))
        return relu(second.forward(inner) + x)
    }
}

// The same, halving the resolution and doubling the width, with the shortcut
// projected to match.
pub block DownBlock<Cin: Dim, Cout: Dim, T: Float> {
    sub first: ConvNorm<Cin, Cout, 3, 2, 1, T>
    sub second: ConvNorm<Cout, Cout, 3, 1, 1, T>
    sub shortcut: ConvNorm<Cin, Cout, 1, 2, 0, T>

    pub fn forward<B: Dim, H: Dim, W: Dim>(
        x: Tensor[B, Cin, H, W; T],
    ) -> Tensor[B, Cout, (H - 1) / 2 + 1, (W - 1) / 2 + 1; T] {
        let inner = relu(first.forward(x))
        return relu(second.forward(inner) + shortcut.forward(x))
    }
}

pub block Stage<Cin: Dim, Cout: Dim, T: Float> {
    sub down: DownBlock<Cin, Cout, T>
    sub rest: Block<Cout, T>

    pub fn forward<B: Dim, H: Dim, W: Dim>(
        x: Tensor[B, Cin, H, W; T],
    ) -> Tensor[B, Cout, (H - 1) / 2 + 1, (W - 1) / 2 + 1; T] {
        return rest.forward(down.forward(x))
    }
}

pub block Model<Height: Dim, Width: Dim, Classes: Dim, T: Float = f32>
where
    Height % 32 == 0,
    Width % 32 == 0
{
    sub stem: ConvNorm<3, 64, 7, 2, 3, T>
    sub stage_0_first: Block<64, T>
    sub stage_0_second: Block<64, T>
    sub stage_1: Stage<64, 128, T>
    sub stage_2: Stage<128, 256, T>
    sub stage_3: Stage<256, 512, T>
    sub classifier: Linear<512, Classes, T>

    pub entry forward<B: Dim>(
        image: Tensor[B, 3, Height, Width; T],
    ) -> Tensor[B, Classes; T] {
        let stemmed = relu(stem.forward(image))
        let pooled = max_pool2d<B, 64, (Height - 1) / 2 + 1, (Width - 1) / 2 + 1, 3, 2, 1, T>(
            stemmed,
        )
        let stage_0 = stage_0_second.forward(stage_0_first.forward(pooled))
        let features = stage_3.forward(stage_2.forward(stage_1.forward(stage_0)))
        return classifier.forward(global_average_pool2d(features))
    }
}
