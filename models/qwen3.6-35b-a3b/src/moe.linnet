// Qwen3.5-MoE's feed-forward block: a router picks `TopK` of `Experts`
// experts per token, by its softmax, renormalized over the chosen (which is
// the softmax of the chosen logits alone); each chosen expert is a SwiGLU
// of width `ExpertInner`, its gate and up projections stored side by side.
// Beside them a shared expert runs on every token, scaled by its own
// sigmoid gate.
//
// The chosen experts go through `std.nn.moe`: on a GPU PyTorch multiplies
// each expert by the rows that chose it (a grouped product), elsewhere the
// bodies' dense form.
module qwen3_5_moe.moe

use std.nn.activations::{sigmoid, silu}
use std.nn.linear::{Linear}
use std.nn.mlp::{SwiGlu}
use std.nn.moe::{combine_experts, linear_experts_shared, top_k}
use std.nn.softmax::{softmax}

pub block SparseMoe<H: Dim, Experts: Dim, TopK: Dim, ExpertInner: Dim, SharedInner: Dim, T: Float>
where
    Experts > 0,
    TopK > 0
{
    sub gate: Linear<H, Experts, T>
    param gate_up_proj: Tensor[Experts, 2 * ExpertInner, H; T]
    param down_proj: Tensor[Experts, H, ExpertInner; T]
    sub shared_expert: SwiGlu<H, SharedInner, T>
    sub shared_expert_gate: Linear<H, 1, T>

    pub fn forward<B: Dim, S: Dim>(x: Tensor[B, S, H; T]) -> Tensor[B, S, H; T] {
        let rows = reshape(x, [B * S, H])
        let logits = gate.forward(rows)
        let expert = top_k<B * S, Experts, TopK, T>(logits)
        // The softmax over the chosen logits alone, in f32: the full softmax
        // renormalized over the chosen, as the reference computes it.
        let chosen[r, k] = cast<f32>(logits[r, expert[r, k]])
        let weight = softmax(chosen)
        let gate_up = linear_experts_shared(rows, gate_up_proj, expert)
        let activated =
            silu(gate_up[:, :, 0:ExpertInner]) * gate_up[:, :, ExpertInner:2 * ExpertInner]
        let routed = combine_experts(activated, down_proj, expert, cast<T>(weight))
        let shared = shared_expert.forward(rows) * sigmoid(shared_expert_gate.forward(rows))
        return reshape(routed + shared, [B, S, H])
    }
}
