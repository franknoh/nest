// A Vision Transformer for image classification, shaped to load the
// published checkpoint as it is: the patch embedding keeps the four-axis
// weight a convolution stores (`[D, C, P, P]`) and reads it as a contraction
// over the patch, and the position table keeps its leading axis of one.
//
// The encoder is the same pre-norm block the language models use, with
// LayerNorm instead of RMS norm, GELU instead of SwiGLU, biases throughout,
// and no mask: every token attends to every other.
module vit

use std.nn.activations::{gelu_erf}
use std.nn.attention::{attention}
use std.nn.linear::{Linear}
use std.nn.norm::{layer_norm}

pub const EPS: f32 = 1e-12

pub block LayerNorm<D: Dim, T: Float> {
    param weight: Tensor[D; T]
    param bias: Tensor[D; T]

    pub fn forward<*S: Shape>(x: Tensor[*S, D; T]) -> Tensor[*S, D; T] {
        return layer_norm(x, weight, some(bias), EPS)
    }
}

pub block Attention<D: Dim, Heads: Dim, T: Float>
where
    Heads > 0,
    D % Heads == 0
{
    sub query: Linear<D, D, T>
    sub key: Linear<D, D, T>
    sub value: Linear<D, D, T>
    sub out: Linear<D, D, T>

    pub fn forward<B: Dim, N: Dim>(x: Tensor[B, N, D; T]) -> Tensor[B, N, D; T] {
        let mixed = attention(
            heads<B, N, Heads, D / Heads, T>(query.forward(x)),
            heads<B, N, Heads, D / Heads, T>(key.forward(x)),
            heads<B, N, Heads, D / Heads, T>(value.forward(x)),
            rsqrt(cast<f32>(D / Heads)),
            none,
        )
        return out.forward(reshape(permute(mixed, [0, 2, 1, 3]), [B, N, D]))
    }
}

fn heads<B: Dim, N: Dim, Heads: Dim, Dh: Dim, T: Float>(
    x: Tensor[B, N, Heads * Dh; T],
) -> Tensor[B, Heads, N, Dh; T] {
    return permute(reshape(x, [B, N, Heads, Dh]), [0, 2, 1, 3])
}

pub block EncoderLayer<D: Dim, Heads: Dim, Inner: Dim, T: Float>
where
    Heads > 0,
    D % Heads == 0
{
    sub norm_before: LayerNorm<D, T>
    sub attention: Attention<D, Heads, T>
    sub norm_after: LayerNorm<D, T>
    sub up: Linear<D, Inner, T>
    sub down: Linear<Inner, D, T>

    pub fn forward<B: Dim, N: Dim>(x: Tensor[B, N, D; T]) -> Tensor[B, N, D; T] {
        let attended = x + attention.forward(norm_before.forward(x))
        return attended + down.forward(gelu_erf(up.forward(norm_after.forward(attended))))
    }
}

pub block Model<
    Height: Dim,
    Width: Dim,
    Channels: Dim,
    Patch: Dim,
    D: Dim,
    Heads: Dim,
    Inner: Dim,
    Layers: Dim,
    Classes: Dim,
    T: Float = f32,
>
where
    Patch > 0,
    Heads > 0,
    Height % Patch == 0,
    Width % Patch == 0,
    D % Heads == 0
{
    // The shapes a `Conv2d` checkpoint stores, read as a contraction below.
    param patch_weight: Tensor[D, Channels, Patch, Patch; T]
    param patch_bias: Tensor[D; T]
    param class_token: Tensor[1, 1, D; T]
    param positions: Tensor[1, (Height / Patch) * (Width / Patch) + 1, D; T]
    sub layers: [EncoderLayer<D, Heads, Inner, T>; Layers]
    sub norm: LayerNorm<D, T>
    sub head: Linear<D, Classes, T>

    pub entry forward<B: Dim>(
        image: Tensor[B, Channels, Height, Width; T],
    ) -> Tensor[B, Classes; T] {
        let patches = embed<B>(image)
        // The class token leads, then the position table adds over the batch.
        let tokens = concat(broadcast_to(class_token, [B, 1, D]), patches, axis = 1) + positions
        var x = tokens
        static for layer in layers {
            x = layer.forward(x)
        }
        // The classifier reads the class token of the normalized sequence.
        return head.forward(norm.forward(x)[:, 0, :])
    }

    // `[B, C, Height, Width]` -> `[B, Patches, D]`: each patch contracted
    // with the convolution's window, in the order a convolution reads it.
    fn embed<B: Dim>(
        image: Tensor[B, Channels, Height, Width; T],
    ) -> Tensor[B, (Height / Patch) * (Width / Patch), D; T] {
        let grid = reshape(image, [B, Channels, Height / Patch, Patch, Width / Patch, Patch])
        let windows = reshape(
            permute(grid, [0, 2, 4, 1, 3, 5]),
            [B, (Height / Patch) * (Width / Patch), Channels, Patch, Patch],
        )
        let embedded[b, p, d] = sum[c, i, j] windows[b, p, c, i, j] * patch_weight[d, c, i, j]
        return embedded + patch_bias
    }
}
