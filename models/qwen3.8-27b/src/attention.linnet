// Qwen3.5's full-attention layers (every fourth): grouped-query attention
// with a per-head RMS norm on the queries and keys, rotary positions on the
// first quarter of each head, and an output gate. `q_proj` gives each head
// its query and its gate side by side (`[Heads, 2 * HeadDim]`); the heads'
// outputs are scaled by `sigmoid(gate)` before `o_proj`.
//
// The caches are the usual `[Batch, KvHeads, MaxSeq, HeadDim]` pair:
// `decode`/`prefill` for one batch at one position, `decode_rows` and
// `prefill_slots` for a server's rows each at its own length, and
// `prefill_packed`/`step_packed` for prompts packed into one sequence.
module qwen3_5.attention

use crate.norm::{RmsNorm}
use crate.rope::{THETA, tables}
use std.nn.activations::{sigmoid}
use std.nn.attention::{causal_mask, grouped_attention, grouped_attention_rows}
use std.nn.cache::{write_at, write_rows, write_slots, write_span, write_tokens}
use std.nn.linear::{Linear}
use std.nn.rope::{rope, rope_rows}

pub block GatedAttention<
    H: Dim,
    Heads: Dim,
    KvHeads: Dim,
    HeadDim: Dim,
    Batch: Dim,
    MaxSeq: Dim,
    T: Float,
>
where
    Heads > 0,
    KvHeads > 0,
    Heads % KvHeads == 0,
    (HeadDim / 4) % 2 == 0,
    MaxSeq > 0,
    Batch > 0
{
    sub q_proj: Linear<H, Heads * HeadDim * 2, T>
    sub k_proj: Linear<H, KvHeads * HeadDim, T>
    sub v_proj: Linear<H, KvHeads * HeadDim, T>
    sub o_proj: Linear<Heads * HeadDim, H, T>
    sub q_norm: RmsNorm<HeadDim, T>
    sub k_norm: RmsNorm<HeadDim, T>

    state cache_k: Tensor[Batch, KvHeads, MaxSeq, HeadDim; T]
    state cache_v: Tensor[Batch, KvHeads, MaxSeq, HeadDim; T]

    // A whole sequence, causal, no cache.
    pub fn forward<B: Dim, S: Dim>(x: Tensor[B, S, H; T]) -> Tensor[B, S, H; T] {
        let (cos_table, sin_table) = tables<S, HeadDim / 4, T>(THETA)
        let (q, gate, k, v) = project<B, S>(x)
        let mixed = grouped_attention(
            rotate<B, Heads, S>(q, cos_table, sin_table),
            rotate<B, KvHeads, S>(k, cos_table, sin_table),
            v,
            rsqrt(cast<f32>(HeadDim)),
            some(causal_mask<S, S>()),
        )
        return finish<B, S>(mixed, gate)
    }

    // One position `pos` for every row.
    pub fn decode(x: Tensor[Batch, 1, H; T], pos: i32) -> Tensor[Batch, 1, H; T] {
        let (cos_table, sin_table) = tables<MaxSeq, HeadDim / 4, T>(THETA)
        let cos_at[d] = cos_table[cast<i64>(pos), d]
        let sin_at[d] = sin_table[cast<i64>(pos), d]
        let cos_row = reshape(cos_at, [1, HeadDim / 4])
        let sin_row = reshape(sin_at, [1, HeadDim / 4])
        let (q, gate, k, v) = project<Batch, 1>(x)
        cache_k = write_at(cache_k, rotate<Batch, KvHeads, 1>(k, cos_row, sin_row), pos)
        cache_v = write_at(cache_v, v, pos)
        let positions = iota<i32>(MaxSeq)
        let seen[s] = positions[s] <= pos
        let mixed = grouped_attention(
            rotate<Batch, Heads, 1>(q, cos_row, sin_row),
            cache_k,
            cache_v,
            rsqrt(cast<f32>(HeadDim)),
            some(reshape(seen, [1, MaxSeq])),
        )
        return finish<Batch, 1>(mixed, gate)
    }

    // `S` positions from `pos` for every row, as a prompt arrives.
    pub fn prefill<S: Dim>(x: Tensor[Batch, S, H; T], pos: i32) -> Tensor[Batch, S, H; T]
    where S > 0 {
        let (cos_table, sin_table) = tables<MaxSeq, HeadDim / 4, T>(THETA)
        let rows[i] = cast<i64>(pos) + iota<i64>(S)[i]
        let cos_rows[i, d] = cos_table[rows[i], d]
        let sin_rows[i, d] = sin_table[rows[i], d]
        let (q, gate, k, v) = project<Batch, S>(x)
        cache_k = write_span(cache_k, rotate<Batch, KvHeads, S>(k, cos_rows, sin_rows), pos)
        cache_v = write_span(cache_v, v, pos)
        let positions = iota<i32>(MaxSeq)
        let queries = iota<i32>(S)
        let seen[i, s] = positions[s] <= pos + queries[i]
        let mixed = grouped_attention(
            rotate<Batch, Heads, S>(q, cos_rows, sin_rows),
            cache_k,
            cache_v,
            rsqrt(cast<f32>(HeadDim)),
            some(seen),
        )
        return finish<Batch, S>(mixed, gate)
    }

    // One position per row, row `b` at `positions[b]`.
    pub fn decode_rows(
        x: Tensor[Batch, 1, H; T],
        positions: Tensor[Batch; i32],
    ) -> Tensor[Batch, 1, H; T] {
        let (cos_table, sin_table) = tables<MaxSeq, HeadDim / 4, T>(THETA)
        let cos_at[b, d] = cos_table[cast<i64>(positions[b]), d]
        let sin_at[b, d] = sin_table[cast<i64>(positions[b]), d]
        let cos_rows = reshape(cos_at, [Batch, 1, HeadDim / 4])
        let sin_rows = reshape(sin_at, [Batch, 1, HeadDim / 4])
        let (q, gate, k, v) = project<Batch, 1>(x)
        cache_k = write_rows(cache_k, rotate_rows<Batch, KvHeads>(k, cos_rows, sin_rows), positions)
        cache_v = write_rows(cache_v, v, positions)
        let slots = iota<i32>(MaxSeq)
        let seen[b, s] = slots[s] <= positions[b]
        let mixed = grouped_attention_rows(
            rotate_rows<Batch, Heads>(q, cos_rows, sin_rows),
            cache_k,
            cache_v,
            rsqrt(cast<f32>(HeadDim)),
            reshape(seen, [Batch, 1, MaxSeq]),
        )
        return finish<Batch, 1>(mixed, gate)
    }

    // `M` prompts of `S` tokens from their first positions into rows
    // `slots`: each prompt's keys and values fill its row, its queries
    // attend causally among themselves.
    pub fn prefill_slots<M: Dim, S: Dim>(
        x: Tensor[M, S, H; T],
        slots: Tensor[M; i32],
    ) -> Tensor[M, S, H; T]
    where
        M > 0,
        S > 0
    {
        let (cos_table, sin_table) = tables<S, HeadDim / 4, T>(THETA)
        let (q, gate, k, v) = project<M, S>(x)
        let rotated = rotate<M, KvHeads, S>(k, cos_table, sin_table)
        cache_k = write_slots(cache_k, rotated, slots, 0)
        cache_v = write_slots(cache_v, v, slots, 0)
        let mixed = grouped_attention(
            rotate<M, Heads, S>(q, cos_table, sin_table),
            rotated,
            v,
            rsqrt(cast<f32>(HeadDim)),
            some(causal_mask<S, S>()),
        )
        return finish<M, S>(mixed, gate)
    }

    // Prompts packed into one sequence: token `p`, position `positions[p]`
    // of row `rows[p]`, attends to its own prompt (`segments`) up to itself.
    pub fn prefill_packed<P: Dim>(
        x: Tensor[1, P, H; T],
        rows: Tensor[P; i32],
        positions: Tensor[P; i32],
        segments: Tensor[P; i32],
    ) -> Tensor[1, P, H; T]
    where P > 0 {
        let (cos_table, sin_table) = tables<MaxSeq, HeadDim / 4, T>(THETA)
        let cos_at[p, d] = cos_table[cast<i64>(positions[p]), d]
        let sin_at[p, d] = sin_table[cast<i64>(positions[p]), d]
        let (q, gate, k, v) = project<1, P>(x)
        let keys = rotate<1, KvHeads, P>(k, cos_at, sin_at)
        cache_k = write_tokens(cache_k, keys, rows, positions)
        cache_v = write_tokens(cache_v, v, rows, positions)
        let own[i, j] = segments[i] == segments[j] && positions[j] <= positions[i]
        let mixed = grouped_attention(
            rotate<1, Heads, P>(q, cos_at, sin_at),
            keys,
            v,
            rsqrt(cast<f32>(HeadDim)),
            some(own),
        )
        return finish<1, P>(mixed, gate)
    }

    // `prefill_packed`'s prompts, `P` tokens, then one step for each of the
    // `Batch` rows at `step_positions[b]`: every token's key and value go to
    // its row at its position, the prompts attend among themselves and each
    // step over its row as in `decode_rows`.
    pub fn step_packed<P: Dim>(
        x: Tensor[1, P + Batch, H; T],
        rows: Tensor[P; i32],
        positions: Tensor[P; i32],
        segments: Tensor[P; i32],
        step_positions: Tensor[Batch; i32],
    ) -> Tensor[1, P + Batch, H; T]
    where P > 0 {
        let every_at = concat(positions, step_positions, axis = 0)
        let every_row = concat(rows, iota<i32>(Batch), axis = 0)
        let (cos_table, sin_table) = tables<MaxSeq, HeadDim / 4, T>(THETA)
        let cos_at[p, d] = cos_table[cast<i64>(every_at[p]), d]
        let sin_at[p, d] = sin_table[cast<i64>(every_at[p]), d]
        let (q, gate, k, v) = project<1, P + Batch>(x)
        let queries = rotate<1, Heads, P + Batch>(q, cos_at, sin_at)
        let keys = rotate<1, KvHeads, P + Batch>(k, cos_at, sin_at)
        cache_k = write_tokens(cache_k, keys, every_row, every_at)
        cache_v = write_tokens(cache_v, v, every_row, every_at)
        let own[i, j] = segments[i] == segments[j] && positions[j] <= positions[i]
        let prompts = grouped_attention(
            queries[:, :, 0:P, :],
            keys[:, :, 0:P, :],
            v[:, :, 0:P, :],
            rsqrt(cast<f32>(HeadDim)),
            some(own),
        )
        let slots = iota<i32>(MaxSeq)
        let seen[b, s] = slots[s] <= step_positions[b]
        let steps = grouped_attention_rows(
            permute(queries[:, :, P:P + Batch, :], [2, 1, 0, 3]),
            cache_k,
            cache_v,
            rsqrt(cast<f32>(HeadDim)),
            reshape(seen, [Batch, 1, MaxSeq]),
        )
        let mixed = concat(prompts, permute(steps, [2, 1, 0, 3]), axis = 2)
        return finish<1, P + Batch>(mixed, gate)
    }

    // Queries and their gates, keys, values: `[B, Heads, S, HeadDim]`,
    // `[B, S, Heads * HeadDim]`, and `[B, KvHeads, S, HeadDim]` twice, the
    // queries and keys normalized.
    fn project<B: Dim, S: Dim>(
        x: Tensor[B, S, H; T],
    ) -> (Tensor[B, Heads, S, HeadDim; T], Tensor[B, S, Heads *
        HeadDim; T], Tensor[B, KvHeads, S, HeadDim; T], Tensor[B, KvHeads, S, HeadDim; T]) {
        let both = reshape(q_proj.forward(x), [B, S, Heads, 2 * HeadDim])
        let q = q_norm.forward(both[:, :, :, 0:HeadDim])
        let gate = reshape(both[:, :, :, HeadDim:2 * HeadDim], [B, S, Heads * HeadDim])
        let k = k_norm.forward(reshape(k_proj.forward(x), [B, S, KvHeads, HeadDim]))
        let v = reshape(v_proj.forward(x), [B, S, KvHeads, HeadDim])
        return (
            permute(q, [0, 2, 1, 3]),
            gate,
            permute(k, [0, 2, 1, 3]),
            permute(v, [0, 2, 1, 3]),
        )
    }

    // The heads merged, gated, projected back.
    fn finish<B: Dim, S: Dim>(
        mixed: Tensor[B, Heads, S, HeadDim; T],
        gate: Tensor[B, S, Heads * HeadDim; T],
    ) -> Tensor[B, S, H; T] {
        let merged = reshape(permute(mixed, [0, 2, 1, 3]), [B, S, Heads * HeadDim])
        return o_proj.forward(merged * sigmoid(gate))
    }

    // Rotary positions on each head's first quarter, one table for the batch.
    fn rotate<B: Dim, N: Dim, S: Dim>(
        x: Tensor[B, N, S, HeadDim; T],
        cos_table: Tensor[S, HeadDim / 4; T],
        sin_table: Tensor[S, HeadDim / 4; T],
    ) -> Tensor[B, N, S, HeadDim; T] {
        let turned = rope(x[:, :, :, 0:HeadDim / 4], cos_table, sin_table)
        return concat(turned, x[:, :, :, HeadDim / 4:HeadDim], axis = -1)
    }

    // `rotate` with a table row per sequence, one position each.
    fn rotate_rows<B: Dim, N: Dim>(
        x: Tensor[B, N, 1, HeadDim; T],
        cos_rows: Tensor[B, 1, HeadDim / 4; T],
        sin_rows: Tensor[B, 1, HeadDim / 4; T],
    ) -> Tensor[B, N, 1, HeadDim; T] {
        let turned = rope_rows(x[:, :, :, 0:HeadDim / 4], cos_rows, sin_rows)
        return concat(turned, x[:, :, :, HeadDim / 4:HeadDim], axis = -1)
    }
}
