// ResNet-50 (v1.5) for ImageNet-1k classification: a 7x7 stem, four stages
// of bottleneck blocks three, four, six, and three deep, spatial averaging,
// and a linear classifier. A bottleneck reduces to a quarter of its stage's
// width with a 1x1 convolution, convolves 3x3 there, and expands back with
// another 1x1; the first bottleneck of a stage also projects the shortcut
// when the width or the resolution changes.
//
// This is v1.5, the variant `microsoft/resnet-50` publishes and the one
// most other ResNet-50 checkpoints now use: the stride that halves the
// resolution sits on the 3x3 convolution rather than the first 1x1, so more
// of the stage's work happens at full resolution. Every convolution keeps
// the four-axis weight the checkpoint stores, and batch normalization is
// the affine transform inference actually computes.
module resnet

use std.nn.activations::{relu}
use std.nn.conv::{Conv2d}
use std.nn.linear::{Linear}
use std.nn.norm::{batch_norm}
use std.nn.pool::{global_average_pool2d, max_pool2d}

// A convolution followed by its normalization, the pair the checkpoint
// stores together.
pub block ConvNorm<Cin: Dim, Cout: Dim, K: Dim, Stride: Dim, Pad: Dim, T: Float>
where
    Stride > 0,
    K > 0
{
    sub convolution: Conv2d<Cin, Cout, K, Stride, Pad, T>
    param running_mean: Tensor[Cout; T]
    param running_var: Tensor[Cout; T]
    param weight: Tensor[Cout; T]
    param bias: Tensor[Cout; T]

    pub fn forward<B: Dim, H: Dim, W: Dim>(
        x: Tensor[B, Cin, H, W; T],
    ) -> Tensor[B, Cout, (H + 2 * Pad - K) / Stride + 1, (W + 2 * Pad - K) / Stride + 1; T] {
        return batch_norm(convolution.forward(x), running_mean, running_var, weight, bias)
    }
}

// A bottleneck at constant width and resolution: 1x1 down to a quarter of
// `C`, 3x3 there, 1x1 back up to `C`, added to the input.
pub block Bottleneck<C: Dim, T: Float>
where C % 4 == 0 {
    sub reduce: ConvNorm<C, C / 4, 1, 1, 0, T>
    sub conv: ConvNorm<C / 4, C / 4, 3, 1, 1, T>
    sub expand: ConvNorm<C / 4, C, 1, 1, 0, T>

    pub fn forward<B: Dim, H: Dim, W: Dim>(
        x: Tensor[B, C, H, W; T],
    ) -> Tensor[B, C, H, W; T] {
        let inner = relu(reduce.forward(x))
        let mid = relu(conv.forward(inner))
        return relu(expand.forward(mid) + x)
    }
}

// The first bottleneck of a stage: it changes width from `Cin` to `Cout`
// and, in every stage but the first, halves the resolution. The stride
// lands on the 3x3 convolution (v1.5), and the shortcut is a 1x1
// convolution plus its normalization at the same stride, so it lands on
// the same grid as the main path before the two are added.
pub block DownBottleneck<Cin: Dim, Cout: Dim, Stride: Dim, T: Float>
where
    Cout % 4 == 0,
    Stride > 0
{
    sub reduce: ConvNorm<Cin, Cout / 4, 1, 1, 0, T>
    sub conv: ConvNorm<Cout / 4, Cout / 4, 3, Stride, 1, T>
    sub expand: ConvNorm<Cout / 4, Cout, 1, 1, 0, T>
    sub shortcut: ConvNorm<Cin, Cout, 1, Stride, 0, T>

    pub fn forward<B: Dim, H: Dim, W: Dim>(
        x: Tensor[B, Cin, H, W; T],
    ) -> Tensor[B, Cout, (H - 1) / Stride + 1, (W - 1) / Stride + 1; T] {
        let inner = relu(reduce.forward(x))
        let mid = relu(conv.forward(inner))
        return relu(expand.forward(mid) + shortcut.forward(x))
    }
}

// `Depth` bottlenecks: one that adapts width and stride, then `Depth - 1`
// at the stage's own width and resolution.
pub block Stage<Cin: Dim, Cout: Dim, Stride: Dim, Depth: Dim, T: Float>
where
    Cout % 4 == 0,
    Stride > 0,
    Depth > 0
{
    sub down: DownBottleneck<Cin, Cout, Stride, T>
    sub rest: [Bottleneck<Cout, T>; Depth - 1]

    pub fn forward<B: Dim, H: Dim, W: Dim>(
        x: Tensor[B, Cin, H, W; T],
    ) -> Tensor[B, Cout, (H - 1) / Stride + 1, (W - 1) / Stride + 1; T] {
        var out = down.forward(x)
        static for layer in rest {
            out = layer.forward(out)
        }
        return out
    }
}

pub block Model<Height: Dim, Width: Dim, Classes: Dim, T: Float = f32>
where
    Height % 32 == 0,
    Width % 32 == 0
{
    sub stem: ConvNorm<3, 64, 7, 2, 3, T>
    sub stage_0: Stage<64, 256, 1, 3, T>
    sub stage_1: Stage<256, 512, 2, 4, T>
    sub stage_2: Stage<512, 1024, 2, 6, T>
    sub stage_3: Stage<1024, 2048, 2, 3, T>
    sub classifier: Linear<2048, Classes, T>

    pub entry forward<B: Dim>(
        image: Tensor[B, 3, Height, Width; T],
    ) -> Tensor[B, Classes; T] {
        let stemmed = relu(stem.forward(image))
        let pooled = max_pool2d<B, 64, (Height - 1) / 2 + 1, (Width - 1) / 2 + 1, 3, 2, 1, T>(
            stemmed,
        )
        // The first stage keeps the resolution max pooling already halved;
        // the rest each halve it again on their down block.
        let stage_0_out = stage_0.forward(pooled)
        let stage_1_out = stage_1.forward(stage_0_out)
        let stage_2_out = stage_2.forward(stage_1_out)
        let features = stage_3.forward(stage_2_out)
        return classifier.forward(global_average_pool2d(features))
    }
}
